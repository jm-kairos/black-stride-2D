# Black Stride ship definition (.ship format).
# Art: assets/ships/ships_cruisers_yellow/cruisers_r0_c0.png (394x1586, nose-up).
# At world_scale 1 the hull is 1586 world units long, which classifies it as a
# CRUISER: slow, heavy inertial flight (see ship_size_class_from_length in sim/ship.cpp).
# An explicit `class <drone|corvette|frigate|destroyer|cruiser|capital>` line can override.

name "ship"
faction 2
world_scale 1.0
size 394 1586

layer sprite assets/ships/ships_cruisers_yellow/cruisers_r0_c0.png 0 0 1 0 0

# Box collider matching the art size.
collider -197 -793
collider 197 -793
collider 197 793
collider -197 793

# Hardpoint skeleton: typed module slots pinned to art pixels.
# Format: hardpoint <id> <accepts> <size> <x> <y> <facing_deg> <arc_deg>
# Coords are ship-local art texels (origin = image center, +Y = nose):
#   local_x = pixel_x - 197, local_y = 793 - pixel_y
# facing is CCW from the nose; arc is the mount's total traverse.
hardpoint radar_dome sensor          S    0  643   0 360
hardpoint bow_gun    weapon          M    0  403   0 180
hardpoint port_gun   weapon          M -122 -107  90 210
hardpoint stbd_gun   weapon          M  122 -107 -90 210
hardpoint dorsal_pd  defense         S    0   33   0 360
hardpoint aft_pd     defense         S    0 -387 180 360
hardpoint engine_bay engine          L    0 -687 180   0
hardpoint cargo_bay  utility         M    0 -247   0   0

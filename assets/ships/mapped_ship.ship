# Black Stride ship definition (.ship format).
# Mapped player vessel: diffuse, normal, depth, and position maps.

name "Mapped Vessel"
faction 2
world_scale 0.06
size 2048 2048

layer mapped assets/ships/mapped_ship/ship_diffuse_map.png assets/ships/mapped_ship/ship_normal_map.png assets/ships/mapped_ship/ship_depth_map.png assets/ships/mapped_ship/ship_position_map.png 0 0 1 0 0

# Box collider (ship-local space). Art is 2048 x 2048; half-size is 1024.
collider -1024 -1024
collider  1024 -1024
collider  1024  1024
collider -1024  1024

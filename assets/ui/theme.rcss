/* =====================================================================================
   theme.rcss — shared base stylesheet for the Black Stride in-game UI (RmlUi / RCSS).

   RCSS is a CSS-2.1 subset. Fonts are registered at startup by bs_rml_load_fonts(
   "assets/ui/fonts") — every .ttf in that folder — and referenced by the family name the
   font advertises. Four shippable OFL font "kits" are bundled and switched live via a
   <body> class (see the FONT KITS section at the foot of this file and the editor panel):
     kit-neon     Orbitron / Rajdhani / Share Tech Mono    (bold sci-fi console)
     kit-clean    Chakra Petch / Inter / JetBrains Mono    (readable techy)
     kit-minimal  Exo 2 / Exo 2 / JetBrains Mono           (understated)
     kit-frontier Barlow Condensed / Barlow / B612 Mono    (default; Space Western industrial)

   SPACE WESTERN art direction: every element reads as a matte plate cut from steel, bolted
   on, and worn by twenty years on the frontier. Depth comes from machined relief, never from
   glow or gloss. box-shadow and CSS filters are unavailable in the SDLGPU backend.

   Depth recipes (used consistently here and in hud.rcss). The primary surfaces are 9-slice
   ninepatch sprites from the ui-skin sheet below (true chamfered corners, bolts, baked
   bevels); elements too small for a 9-slice ring (gm-cells, gauges) fall back to CSS bevels:
     PLATE    panel body: `plate` / `plate-sm` ninepatch (chamfers, corner bolts, iron edge)
     RAISED   button/tile: `btn` family ninepatch; hover = btn-hi, active/selected = btn-amber
     RECESSED well/socket: `well` / `socket` ninepatch, or dark fill + inverted CSS bevel
     SEAM     divider: 1px dark groove over a 1px light lip (armor seam)

   Colour tokens (Space Western):
     surfaces  iron-void #0b0c0e  charcoal #17191d  gunmetal #22262c  graphite #2e333a
               steel-hi #3d434b   steel-lite #565c63  nickel #788089
     text      ivory #ddd6c4  ivory-bright #f2ead6  beige #a89a7e  beige-dim #6e6555
     accents   amber #c9963f (selection/active ONLY)  amber-bright #e8b45a
               copper #a3543a (destructive)  brass-olive #8f9a4f (+)  dull-orange #b3622f (-)
   ===================================================================================== */

body {
    font-family: "Inter";       /* base = Clean kit; kit classes override below */
    font-weight: 500;            /* medium — crisper, less spindly than book weight */
    font-style: normal;
    font-size: 15px;
    color: #ddd6c4;
}

/* =====================================================================================
   UI SKIN — 9-slice fabricated-plate sprites, generated by tools\ui_skin_gen.py (edit the
   script + re-run to retune; rectangles here MUST match the script's atlas layout).
   Each ninepatch pairs an outer sprite with an inner sprite whose rect defines the
   stretchable centre; the ring between them (chamfers, bolts, machined bevels) never
   deforms. RmlUi resolves src relative to this stylesheet -> assets/ui/skin/plates.png.
   ===================================================================================== */
@spritesheet ui-skin {
    src: skin/plates.png;
    resolution: 2x;   /* sheet is authored at 2x texels -> 2x supersampled on screen */
    /* Panel plates carry a 12-texel baked drop-shadow margin (6 display px): the visible
       plate edge sits 6px inside the element box, so panel padding compensates (+6px). */
    plate:             0px   0px   152px 152px;   /* gunmetal armor plate, bolts, shadow */
    plate-inner:       44px  44px  64px  64px;
    plate-amber:       156px 0px   152px 152px;   /* amber-painted alert frame, shadow   */
    plate-amber-inner: 200px 44px  64px  64px;
    rail:              312px 0px   128px 64px;    /* stamped window-header band          */
    rail-inner:        328px 16px  96px  32px;
    btn:               0px   156px 64px  64px;    /* raised machined cap (rest)          */
    btn-inner:         16px  172px 32px  32px;
    btn-hi:            68px  156px 64px  64px;    /* hover: one step lighter             */
    btn-hi-inner:      84px  172px 32px  32px;
    btn-amber:         136px 156px 64px  64px;    /* active/selected: amber edge         */
    btn-amber-inner:   152px 172px 32px  32px;
    well:              204px 156px 64px  64px;    /* recessed drop tray                  */
    well-inner:        220px 172px 32px  32px;
    socket:            272px 156px 64px  64px;    /* recessed empty socket               */
    socket-inner:      288px 172px 32px  32px;
    copper-btn:        340px 156px 64px  64px;    /* oxidized copper destructive control */
    copper-btn-inner:  356px 172px 32px  32px;
    plate-sm:          408px 156px 88px  88px;    /* light plate + shadow: HUD readouts  */
    plate-sm-inner:    436px 184px 32px  32px;
    chan:              0px   248px 32px  16px;    /* recessed gauge channel (capacitor)  */
    chan-inner:        8px   252px 16px  8px;
}

/* Emblem stencils (tools\ui_icon_gen.py): WHITE-on-transparent military insignias for the
   Arsenal tiles, tinted per state via `image-color` in hud.rcss. 52px cells = 26px display. */
@spritesheet ui-icons {
    src: skin/icons.png;
    resolution: 2x;
    ic-cannon:  0px   4px 52px 52px;   /* ballistic cannon turret        */
    ic-pd:      56px  4px 52px 52px;   /* point-defense turret           */
    ic-sensor:  112px 4px 52px 52px;   /* sensor/surveyor dish array     */
    ic-empty:   168px 4px 52px 52px;   /* open socket (empty bay)        */
    ic-missile: 224px 4px 52px 52px;   /* guided-missile launcher        */
}

/* --- Card / panel container ------------------------------------------------------- */
/* PLATE: a fabricated armor plate cut from the ui-skin sheet — true chamfered corners,
   corner bolts, machined bevels, baked ambient occlusion and a soft baked drop shadow
   (the plate floats over the scene; the 22px padding = 6px shadow margin + 16px ring). */
.panel {
    decorator: ninepatch(plate, plate-inner);
    padding: 22px;               /* 6px baked shadow margin + 16px plate ring */
}

.panel.accent {
    decorator: ninepatch(plate-amber, plate-amber-inner);   /* amber priority frame (encounter alert) */
}

/* --- Headings --------------------------------------------------------------------- */
.title {
    font-size: 13px;
    font-weight: 700;              /* bold display weight — reads crisp, not thin */
    color: #a89a7e;
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-effect: shadow(1px 1px #000000a0);   /* stamped into the plate */
}

/* --- Stat rows: a label on the left, a monospaced value on the right --------------- */
.row {
    display: block;
    margin-bottom: 4px;
}

.label {
    color: #a89a7e;
    margin-right: 6px;
}

.value {
    color: #ddd6c4;
}

.value.amber {
    color: #e8b45a;
}

/* --- Armor-seam divider (SEAM: dark groove + light lip) ---------------------------- */
.rule {
    display: block;
    height: 1px;                 /* 1px groove + 1px lip border = 2px seam */
    background-color: #0b0c0e;
    border-bottom: 1px #454b53;
    margin: 8px 0;
}

/* =====================================================================================
   FONT KITS — live-switchable typeface sets. The game sets ui_kit (0/1/2/3), which toggles a
   <body> class (kit-neon / kit-clean / kit-minimal / kit-frontier) via data-binding in hud.rml.
   Three type roles: body text (inherited from <body>), the DISPLAY group (headings/titles/tabs)
   and the MONO group (numeric & technical readouts). The base rules use the CLEAN kit, so
   kit-clean needs no overrides here; the other kits restate the three roles.
   ===================================================================================== */

/* Base = Clean kit: Chakra Petch (display) / Inter (body, on <body>) / JetBrains Mono (mono). */
.title, .win-title, .modal-title, .insp-tab, .insp-section-hdr, .fleet-name, #jumpmode {
    font-family: "Chakra Petch";
}
.value, .hud-val, .weapon-row, .ship-preview-name, #debug, #tooltip,
.planet-insp-line, .market-colhead, .card-rows, .card-stats, .card-mode {
    font-family: "JetBrains Mono";
}

/* Kit 0 — Neon: Orbitron (display) / Rajdhani (body) / Share Tech Mono (mono). */
body.kit-neon { font-family: "Rajdhani"; }
body.kit-neon .title, body.kit-neon .win-title, body.kit-neon .modal-title,
body.kit-neon .insp-tab, body.kit-neon .insp-section-hdr, body.kit-neon .fleet-name,
body.kit-neon #jumpmode {
    font-family: "Orbitron";
}
body.kit-neon .value, body.kit-neon .hud-val, body.kit-neon .weapon-row,
body.kit-neon .ship-preview-name,
body.kit-neon #debug, body.kit-neon #tooltip, body.kit-neon .planet-insp-line,
body.kit-neon .market-colhead, body.kit-neon .card-rows, body.kit-neon .card-stats,
body.kit-neon .card-mode {
    font-family: "Share Tech Mono";
}

/* Kit 2 — Minimal: Exo 2 (display + body) / JetBrains Mono (mono). */
body.kit-minimal { font-family: "Exo 2"; }
body.kit-minimal .title, body.kit-minimal .win-title, body.kit-minimal .modal-title,
body.kit-minimal .insp-tab, body.kit-minimal .insp-section-hdr, body.kit-minimal .fleet-name,
body.kit-minimal #jumpmode {
    font-family: "Exo 2";
}
body.kit-minimal .value, body.kit-minimal .hud-val, body.kit-minimal .weapon-row,
body.kit-minimal .ship-preview-name,
body.kit-minimal #debug, body.kit-minimal #tooltip, body.kit-minimal .planet-insp-line,
body.kit-minimal .market-colhead, body.kit-minimal .card-rows, body.kit-minimal .card-stats,
body.kit-minimal .card-mode {
    font-family: "JetBrains Mono";
}

/* Kit 3 — Frontier (default): Barlow Condensed (display) / Barlow (body) / B612 Mono (mono).
   Space Western: industrial condensed labeling, cockpit-instrument readouts (B612 Mono was
   designed by Airbus for flight-deck displays). Mid-weight statics advertise their typographic
   family (nameID 16: plain "Barlow" / "Barlow Condensed"), which FreeType prefers, so the clean
   family names below match every weight. */
body.kit-frontier { font-family: "Barlow"; }
body.kit-frontier .title, body.kit-frontier .win-title, body.kit-frontier .modal-title,
body.kit-frontier .insp-tab, body.kit-frontier .insp-section-hdr, body.kit-frontier .fleet-name,
body.kit-frontier #jumpmode {
    font-family: "Barlow Condensed";
}
body.kit-frontier .value, body.kit-frontier .hud-val, body.kit-frontier .weapon-row,
body.kit-frontier .ship-preview-name,
body.kit-frontier #debug, body.kit-frontier #tooltip, body.kit-frontier .planet-insp-line,
body.kit-frontier .market-colhead, body.kit-frontier .card-rows, body.kit-frontier .card-stats,
body.kit-frontier .card-mode {
    font-family: "B612 Mono";
}

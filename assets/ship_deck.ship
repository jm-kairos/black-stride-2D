# Black Stride ship definition (.ship format).
# name, faction, world_scale, size, sprite layers, and authored collision polygon.

name "Player Vessel"
faction 2
world_scale 0.25
size 360 655

layer sprite assets/textures/ship.png 0 0 1 0 0

# Box collider (ship-local space)
collider -180 -327.5
collider  180 -327.5
collider  180  327.5
collider -180  327.5
